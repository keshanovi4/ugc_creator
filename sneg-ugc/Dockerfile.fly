FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
RUN apk add --no-cache su-exec
COPY --chown=node:node package.json ./
COPY --chown=node:node server ./server
COPY --chown=node:node dist ./dist
COPY --chown=node:node scripts ./scripts
RUN sh -n /app/scripts/fly-entrypoint.sh && chmod 755 /app/scripts/fly-entrypoint.sh
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Only initialize the mounted directory as root, then run the app as node.
ENTRYPOINT ["/app/scripts/fly-entrypoint.sh"]
CMD ["node","server/index.mjs"]
