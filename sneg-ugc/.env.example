NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=https://your-kz-server.example
DATABASE_PATH=./data/ugc.sqlite
BACKUP_DIRECTORY=./backups
# Never enable demo mode with real applicants.
DEMO_MODE=false
PILOT_MODE=false
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Comma separated numeric Telegram IDs. Separate roles; an ID in both is admin.
ADMIN_IDS=
MANAGER_IDS=
SESSION_SECRET=
# Keep stable: changing this key requires reconnecting integrations.
INTEGRATION_SECRET=
AI_PROVIDER=rules
# Optional: ollama (local) or gemini (cloud). No names, contacts, links or free text are sent.
AI_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
GEMINI_API_KEY=
AI_DAILY_LIMIT=400
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
BUSINESS_TIMEZONE=Asia/Almaty
WORKER_INTERVAL_MS=2000
AI_MIN_INTERVAL_MS=5000
